---
import { Image } from "astro:assets";
import HeroIlust from "../../assets/pics/hero-pic.png";
import Section from "./Section.astro";

---

<Section id="home">
  <div
    class="grid grid-cols-1 grid-template md:grid-cols-2 md:grid-rows-1 mt-[135px]"
  >
    <div class="flex flex-col w-full lg:w-[66.5%]">
      <h1>Built for Optimal Transaction Speed, & Security</h1>
    </div>
    <picture class="row-span-1 md:row-span-3">
      <Image src={HeroIlust} alt="Hero Ilustration" loading="eager" />
    </picture>
    <div class="w-full lg:w-[66.5%]">
      <p class="my-[35px]">
        Axis is a fork of Litecoin v0.24.1. Created to be a fast, secure, and reliable currency for everyday transactions.
      </p>
      <a href="/axis-core-multiplatform.zip" download="axis-core-multiplatform.zip" class="btn-primary w-full md:w-auto">
          Download Axis Core
        </a>
      <!-- <button class="btn-primary w-full md:w-auto">Download Axis Core</button> -->
    </div>
  </div>
</Section>
<style>
  .grid-template {
    grid-template-rows: auto 1fr;
  }
</style>
